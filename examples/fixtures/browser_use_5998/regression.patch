+	async def test_keyword_only_parameters_no_browser(self, registry):
+		"""issue:5998 Preserve keyword-only parameters when executing an action."""
+
+		@registry.action('Action with a keyword-only parameter')
+		async def keyword_only_action(text: str, *, number: int = 10):
+			return ActionResult(
+                extracted_content=f'Text: {text}, Number: {number}'
+            )
+		
+		result = await registry.execute_action(
+            'keyword_only_action', {'text': 'hello', 'number': 42}
+        )
+
+		assert isinstance(result, ActionResult)
+		assert result.extracted_content is not None
+		assert result.extracted_content == 'Text: hello, Number: 42'
