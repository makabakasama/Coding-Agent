+"""Frozen acceptance tests R for task-status-endpoint (V0.5 first real task).
+
+AUTHORITY: these tests define the required behaviour. The Agent must not modify
+this file, any other test, or project configuration.
+
+Design: no PostgreSQL or Redis server is needed. The real TaskService is
+exercised with an in-memory repository and an in-memory cache through FastAPI
+dependency overrides, so the tests cover business logic rather than mocks of
+the implementation under test.
+"""
+from __future__ import annotations
+
+import pytest
+from fastapi.testclient import TestClient
+from redis.exceptions import RedisError
+
+from demo_projects.app.dependencies import get_task_service
+from demo_projects.app.main import app
+from demo_projects.app.service import TaskService
+
+API_KEY = "frozen-test-key"
+HEADERS = {"X-API-Key": API_KEY}
+
+
+class FakeRepository:
+    """Mirrors the existing TaskRepository.update_status contract."""
+
+    def __init__(self):
+        self.tasks = {
+            1: {"id": 1, "goal": "demo task", "priority": "normal", "status": "pending"}
+        }
+
+    def get(self, task_id):
+        task = self.tasks.get(task_id)
+        return dict(task) if task is not None else None
+
+    def update_status(self, task_id, status):
+        task = self.tasks.get(task_id)
+        if task is None:
+            return None
+        task["status"] = status
+        return dict(task)
+
+
+class FakeRedis:
+    def __init__(self, fail_on_delete=False):
+        self.store = {}
+        self.deleted = []
+        self.fail_on_delete = fail_on_delete
+
+    def get(self, key):
+        return self.store.get(key)
+
+    def set(self, key, value, ex=None):
+        self.store[key] = value
+
+    def delete(self, key):
+        if self.fail_on_delete:
+            raise RedisError("cache unavailable")
+        self.deleted.append(key)
+        self.store.pop(key, None)
+
+    def lpush(self, key, value):
+        return 1
+
+
+@pytest.fixture(autouse=True)
+def _api_key(monkeypatch):
+    monkeypatch.setenv("DEMO_API_KEY", API_KEY)
+
+
+@pytest.fixture
+def fake_service(monkeypatch):
+    service = TaskService(FakeRepository(), FakeRedis())
+    monkeypatch.setitem(app.dependency_overrides, get_task_service, lambda: service)
+    yield service
+    app.dependency_overrides.pop(get_task_service, None)
+
+
+@pytest.fixture
+def client(fake_service):
+    test_client = TestClient(app)
+    try:
+        yield test_client
+    finally:
+        test_client.close()
+
+
+def test_existing_get_task_still_works(client):
+    """Control: the pre-existing GET endpoint must keep working."""
+    response = client.get("/tasks/1", headers=HEADERS)
+    assert response.status_code == 200
+    assert response.json() == {
+        "id": 1,
+        "goal": "demo task",
+        "priority": "normal",
+        "status": "pending",
+    }
+
+
+def test_patch_status_returns_updated_task(client):
+    """Target 1: PATCH updates the status and returns the updated task."""
+    response = client.patch("/tasks/1", json={"status": "running"}, headers=HEADERS)
+    assert response.status_code == 200
+    assert response.json() == {
+        "id": 1,
+        "goal": "demo task",
+        "priority": "normal",
+        "status": "running",
+    }
+
+
+def test_patch_status_rejects_unknown_status(client):
+    """Target 2: an out-of-contract status is rejected before reaching the service."""
+    response = client.patch("/tasks/1", json={"status": "archived"}, headers=HEADERS)
+    assert response.status_code == 422
+
+
+def test_patch_status_missing_task_returns_404(client):
+    """Target 3: updating a non-existent task is a 404, not a 500 or a no-op."""
+    response = client.patch("/tasks/999", json={"status": "running"}, headers=HEADERS)
+    assert response.status_code == 404
+    assert response.json() == {"detail": "Task not found"}
+
+
+def test_patch_status_invalidates_read_cache(client, fake_service):
+    """Target 4: a cached read must not return a stale status after an update."""
+    first = client.get("/tasks/1", headers=HEADERS)
+    assert first.status_code == 200
+    assert first.json()["status"] == "pending"
+
+    updated = client.patch("/tasks/1", json={"status": "completed"}, headers=HEADERS)
+    assert updated.status_code == 200
+
+    second = client.get("/tasks/1", headers=HEADERS)
+    assert second.status_code == 200
+    assert second.json()["status"] == "completed", (
+        "GET returned a cached task with the old status; the status update must "
+        "invalidate or refresh the task:{id} read cache"
+    )
+
+
+def test_patch_status_survives_cache_backend_failure(monkeypatch):
+    """Target 5: cache invalidation failure must not fail the status update."""
+    service = TaskService(FakeRepository(), FakeRedis(fail_on_delete=True))
+    monkeypatch.setitem(app.dependency_overrides, get_task_service, lambda: service)
+    test_client = TestClient(app)
+    try:
+        response = test_client.patch(
+            "/tasks/1", json={"status": "failed"}, headers=HEADERS
+        )
+        assert response.status_code == 200
+        assert response.json()["status"] == "failed"
+    finally:
+        test_client.close()
+        app.dependency_overrides.pop(get_task_service, None)
