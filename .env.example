# Copy to .env and fill in your own local key.
LLM_PROVIDER=openai_compatible
LLM_PROFILE=gpt

QWEN_MODEL=qwen3-coder-flash
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=

GPT_MODEL=gpt-5.4-mini
GPT_BASE_URL=
GPT_API_KEY=

# PostgreSQL task records and durable queue. Required for API and Worker.
DATABASE_URL=

# Optional read cache. Redis failures fall back to PostgreSQL.
REDIS_URL=redis://127.0.0.1:6379/0
